!!!system-decoration: [(bras)][vox][(str)][klav]
!!!RDF**kern: > = above
!!!RDF**kern: < = below
!!LO:MO:mod
!! !!!RDF**kern: @ = marked note, color=grey
!!LO:MO:end
!!!filter-modern: shed -e "s/LO:N:/LO:n:$1/L" | shed -e "s/LO:DY:/LO:dy:$1/L" | shed -e "s/^(X?)tuplet$/$1TUPLET/I" | shed -e "s/^(\d+[\/\\]right)/$1yy/I" | shed -e "s/TX(.*):t=P:/tx$1:t=P:/LG" | shed -k -e "s/([^a-gA-Gn#X-])[<>]/$1/Dg" | sic -sq | autostem -r | tie -s | humtr -p | modori -m

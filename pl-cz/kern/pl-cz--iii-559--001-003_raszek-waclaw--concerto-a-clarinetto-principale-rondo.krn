!!!system-decoration: [(s1,s2)][(bras)]<s5>[(str)]
!!!RDF**kern: > = above
!!!RDF**kern: < = below
!!!RDF**kern: | = vertical stroke
!!LO:MO:mod
!! !!!RDF**kern: @ = marked note, color=grey
!!LO:MO:end
!!!filter-modern: shed -e "s/^(\d+[\/\\]right)/$1yy/I" | shed -e "s/TX(.*):t=P:/tx$1:t=P:/LG" | shed -e "s/LO:DY:/LO:dy:$1/L" | shed -e "s/LO:N:/LO:n:$1/L" | shed -e "s/^(X?)rep$/$1REP/I" | shed -e "s/^custos:/Xcustos:/I" | shed -e "s/^(X?)tuplet$/$1TUPLET/I" | sic -sq | modori -m | autostem -r | tie -s | shed -e "s/yy//"
